# Copy this file to `.env` and fill in real values.
# Do NOT commit .env to git.

# ---- Gmail SMTP (required for auto-send) ----
# 1. Enable 2FA on Gmail first: https://myaccount.google.com/security
# 2. Generate an App Password:  https://myaccou nt.google.com/apppasswords
#    - Label it something like "job-hunter"
#    - It will be a 16-char string with spaces (e.g. "abcd efgh ijkl mnop").
#    - Keep the spaces — Gmail requires them.
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ---- LLM providers (optional; template fallback works without) ----
# At least one of these makes cover letters actually tailored.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
